# Copia este archivo a .env y ajusta lo que necesites.
# El .env NO se versiona.
#
# Lo leen dos cosas:
#   - docker compose, para los puertos y las credenciales del contenedor
#   - Django, tambien al correr con el venv (via python-dotenv)
#
# Si tu PostgreSQL local usa los valores estandar, no necesitas este archivo.

# --- Base de datos ---
POSTGRES_DB=cointeca_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Puerto al que se conecta Django. Dentro de docker compose se ignora
# (el contenedor habla con el servicio 'db' por el 5432 interno).
POSTGRES_PORT=5432

# --- Puertos publicados en el host por docker compose ---
DB_HOST_PORT=5433
WEB_HOST_PORT=8001

# --- Django ---
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Obligatorio poner una clave propia si DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
