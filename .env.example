# Copia este archivo a .env y ajusta lo que necesites.
# docker compose toma estos valores automaticamente.

# --- Base de datos ---
POSTGRES_DB=cointeca_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# --- Puertos publicados en el host ---
# 5432 y 8000 suelen estar ocupados por otros proyectos
DB_HOST_PORT=5433
WEB_HOST_PORT=8001

# --- Django ---
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Obligatorio poner una clave propia si DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
